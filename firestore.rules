rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /wisata/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /umkm/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /gallery/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /news/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /anggota/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /programs/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /pesan/{docId} {
      allow read: if request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
